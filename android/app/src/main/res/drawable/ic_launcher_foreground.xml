<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Glowing isometric hexagon / cube AI emblem -->
    <!-- Top Face -->
    <path
        android:pathData="M54,28 L78,41.5 L54,55 L30,41.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="28"
                android:endX="78"
                android:endY="55"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#00A8FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Face -->
    <path
        android:pathData="M30,41.5 L54,55 L54,80 L30,66.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="41.5"
                android:endX="54"
                android:endY="80"
                android:type="linear">
                <item android:color="#0080FF" android:offset="0.0" />
                <item android:color="#4B0082" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Face -->
    <path
        android:pathData="M54,55 L78,41.5 L78,66.5 L54,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="41.5"
                android:endX="78"
                android:endY="80"
                android:type="linear">
                <item android:color="#8A2BE2" android:offset="0.0" />
                <item android:color="#00E5FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Neural Lines (Glowing neon circuits) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:pathData="M54,34 L72,44 L54,54 L36,44 Z" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#00F0FF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M54,55 L54,76" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#00F0FF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M34,48 L48,56 L48,72" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#C084FC"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M74,48 L60,56 L60,72" />

    <!-- Central Neural Spark (Girionix Core) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,50 L56,54 L60,54 L57,56.5 L58.5,60 L54,57.5 L49.5,60 L51,56.5 L48,54 L52,54 Z" />

    <!-- Outer Tech Accents -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00F0FF"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M50,24 L54,22 L58,24" />

    <path
        android:fillColor="#00000000"
        android:strokeColor="#A855F7"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M50,84 L54,86 L58,84" />
</vector>
