# =====================================================================
# GIRIONIX AI — ENVIRONMENT VARIABLES CONFIGURATION (.env)
# =====================================================================
# In Vite applications, all environment variables accessible to client-side
# code in the browser MUST start with the prefix `VITE_`.
#
# When deploying to Cloudflare Pages:
# Add these variables under: Project Settings -> Environment variables -> Production & Preview
# =====================================================================

# 1. OpenRouter API Key (Universal AI Core: GPT-4o, Claude 3.7, DeepSeek R1, Llama 3.3)
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here

# 2. Google AI Studio (Gemini 2.5 Pro, Gemini 2.5 Flash, Gemini 2.0 Flash Thinking)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Replicate API Token (FLUX.1 Cinema 8K, FLUX Ultra-Realism image generation)
# Get your token at: https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=your_replicate_api_token_here

# 4. Groq Cloud API Key (Optional: Ultra-fast 500+ tok/s Llama 3.3 / Qwen Coder)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# 5. DeepSeek Direct API Key (Optional: Direct DeepSeek platform access)
# Get your key at: https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
