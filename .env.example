# =====================================================================
# GIRIONIX AI — ENVIRONMENT VARIABLES CONFIGURATION (.env)
# =====================================================================
# You can use EITHER format:
# - Standard format:   OPENROUTER_API_KEY=...
# - Vite client format: VITE_OPENROUTER_API_KEY=...
#
# When deploying to Cloudflare Pages:
# Add these variables in Cloudflare Dashboard:
# Workers & Pages -> your-project -> Settings -> Environment Variables
# (Both VITE_ and plain names are automatically recognized!)
# =====================================================================

# 1. OpenRouter Universal Key (GPT-4o, Claude 3.7, DeepSeek R1, Llama 3.3, Qwen)
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
OPENROUTER_API_KEY=

# 2. Google AI Studio (Gemini 2.5 Pro, Gemini 2.5 Flash, Gemini 2.0 Flash Thinking)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
GEMINI_API_KEY=

# 3. Replicate API Token (FLUX.1 Cinema 8K, FLUX Ultra-Realism image generation)
# Get your token at: https://replicate.com/account/api-tokens
VITE_REPLICATE_API_TOKEN=
REPLICATE_API_TOKEN=

# 4. Groq Cloud API Key (Ultra-fast 500+ tok/s Llama 3.3 / Qwen Coder)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=
GROQ_API_KEY=

# 5. DeepSeek Direct API Key (Direct DeepSeek Chat & Reasoner)
# Get your key at: https://platform.deepseek.com/api_keys
VITE_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=

# 6. OpenAI Direct API Key (Direct GPT-4o, o3-mini)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=
OPENAI_API_KEY=

# 7. Anthropic Direct API Key (Direct Claude 3.7 Sonnet)
# Get your key at: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
